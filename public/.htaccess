Options -Indexes
DirectoryIndex index.php

# ── Gzip compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/x-font-ttf font/opentype image/svg+xml
</IfModule>

# ── Browser caching ───────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml        "access plus 1 year"
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/webp           "access plus 1 year"
    ExpiresByType font/woff2           "access plus 1 year"
    ExpiresByType font/woff            "access plus 1 year"
    ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ── Security & Cache-Control headers ─────────────────────────
<IfModule mod_headers.c>

    # Assets estáticos: cache agresivo (tienen contenthash en nombre)
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML dinámico: nunca cachear (datos autenticados de firma)
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # ── Previene que el browser "adivine" el MIME type del contenido
    #    → Previene ataques MIME sniffing (drive-by-download, XSS via SVG, etc.)
    Header always set X-Content-Type-Options "nosniff"

    # ── Impide que la app sea embebida en iframes de dominios externos
    #    → Previene Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # ── Activa el filtro XSS del browser (legacy, aún útil en IE/Edge antiguo)
    #    → Previene XSS reflejado en navegadores sin CSP support
    Header always set X-XSS-Protection "1; mode=block"

    # ── Controla qué información de origen se envía en el header Referer
    #    → Evita filtrar rutas internas a sitios externos
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ── Deshabilita acceso a hardware sensible desde el contexto de la app
    #    → Previene abuso de APIs de geolocalización, cámara, micrófono
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # ── Content Security Policy
    #    Permite: scripts/estilos de self + CDNs de Bootstrap/AdminLTE
    #    Bloquea: eval(), inline scripts sin nonce, frames externos
    #    El Service Worker (sw.js) vive en 'self' → worker-src 'self'
    #    NOTA: Si Bootstrap CDN cambia de host, actualizar script-src/style-src aquí.
    #    → Previene XSS, data injection, clickjacking
    Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; \
style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com 'unsafe-inline'; \
font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; \
img-src 'self' data: blob:; \
connect-src 'self'; \
worker-src 'self'; \
manifest-src 'self'; \
frame-ancestors 'self'; \
base-uri 'self'; \
form-action 'self'"

    # ── HSTS: fuerza HTTPS por 1 año (SOLO producción — comentar en localhost)
    #    Para activar: descomentar la línea de abajo y asegurarse de tener SSL
    #    → Previene downgrade attacks y SSL stripping
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

</IfModule>

# ── URL rewriting ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── Denegar acceso a archivos ocultos (.env, .git, etc.) ─────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
