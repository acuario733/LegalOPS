APP_NAME="LegalOPS Cloud"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC

SESSION_NAME=legalops_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=120

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legalops
DB_USERNAME=legalops
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Redis (Rate Limiting en producción)
# Dejar REDIS_HOST vacío para usar RateLimiter en memoria (desarrollo/tests)
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_TRANSPORT=local
MAIL_SPOOL_PATH=storage/temp/mail

LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BIN=
