APP_NAME="LegalOPS Cloud"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC

SESSION_NAME=legalops_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=120

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legalops
DB_USERNAME=legalops
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Redis (Rate Limiting en producción)
# Dejar REDIS_HOST vacío para usar RateLimiter en memoria (desarrollo/tests)
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_TRANSPORT=local
MAIL_SPOOL_PATH=storage/temp/mail
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@legalops.local
MAIL_FROM_NAME="LegalOPS Cloud"

S3_KEY=
S3_SECRET=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

APP_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net
DOCUSIGN_OAUTH_BASE_URL=https://account-d.docusign.com
DOCUSIGN_REDIRECT_URI=
DOCUSIGN_WEBHOOK_SECRET=

# MFA (Multi-Factor Authentication) — Fase 6
# MFA_ENABLED=false activa la exigencia de TOTP para los roles configurados
MFA_ENABLED=false
# Nombre del emisor que aparece en la app autenticadora (Google Authenticator, Authy, etc.)
MFA_ISSUER="LegalOPS Cloud"
# Digitos del codigo TOTP (6 u 8)
MFA_DIGITS=6
# Ventana de tolerancia en periodos de 30s (1 = ±30s)
MFA_WINDOW=1
# Intentos fallidos antes de bloquear (TTL=MFA_ATTEMPTS_TTL segundos en Redis)
MFA_ATTEMPTS_MAX=5
MFA_ATTEMPTS_TTL=900
# Longitud y cantidad de codigos de recuperacion estaticos
MFA_RECOVERY_LENGTH=8
MFA_RECOVERY_COUNT=8
# Cola donde se despachan los OTP de recuperacion por correo
MFA_RECOVERY_QUEUE=mfa.recovery_otp.send
# Clave dedicada para cifrar secretos TOTP (AES-256-GCM).
# Si se deja vacia, se usa APP_ENCRYPTION_KEY como fallback.
MFA_ENCRYPTION_KEY=
# Roles que deben completar MFA al iniciar sesion (separados por coma)
MFA_REQUIRE_FOR_ROLES=superadmin,admin

# CORS — orígenes autorizados para /api/v1/* (separados por coma, sin espacios)
# Dejar vacío para bloquear todos los orígenes cross-origin.
# Usar * solo en entornos de desarrollo; en producción especificar dominios exactos.
# Ejemplo: CORS_ALLOWED_ORIGINS=https://app.ejemplo.com,https://panel.ejemplo.com
CORS_ALLOWED_ORIGINS=

LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BIN=
